// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/db"
}

datasource db {
  provider = "sqlite"
}

model Group {
  id   String @id @default(uuid())
  uid  String
  nth  Int
  name String
  fold Int

  @@map("groups")
}

model App {
  id      String @id @default(uuid())
  uid     String
  gid     String
  name    String
  desc    String
  cover   String
  url_lan String
  url_wan String
  type    Int
  open    Int
  nth     Int

  @@map("apps")
}

model Image {
  id           String @id @default(uuid())
  uid          String
  title        String
  filepath     String
  created_time String

  @@map("images")
}

model Engine {
  id    String
  name  String @id
  title String
  icon  String
  url   String
  uid   String

  @@map("engines")
}

model Config {
  id    String
  name  String @id
  title String
  value String
  uid   String

  @@map("configs")
}
