{
  "name": "bun-panel",
  "module": "src/server.ts",
  "type": "module",
  "version": "1.0.4",
  "keywords": [
    "panel",
    "nas",
    "navigation",
    "bun",
    "bunjs"
  ],
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "DATABASE_DIR=file:./data PORT=5555 STATIC_DIR=./data bun --hot run src/server.ts",
    "test": "bun test test/*.ts",
    "init-prisma": "bunx --bun prisma init --datasource-provider sqlite --output ./db",
    "edit-prisma": "bunx --bun prisma generate",
    "init-sqlite": "bunx --bun prisma migrate dev --name init",
    "coverage": "bun test --coverage test/*"
  },
  "devDependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/bun": "^1.3.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.6.2",
    "@types/uuid": "^10.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.7",
    "ajv": "^8.17.1",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "linkedom": "^0.18.12",
    "lodash": "^4.17.21",
    "log4js": "^6.9.1",
    "mime": "^4.0.4",
    "multer": "^1.4.5-lts.1",
    "patch-package": "^8.0.0",
    "prisma": "^7.8.0",
    "uuid": "^10.0.0"
  }
}
